{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Edition Milestone Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "milestone_id",
    "before_assessment_id",
    "after_assessment_id",
    "change_type",
    "trigger_claim_ids",
    "trigger_evidence_ids",
    "trigger_event_ids",
    "review_id",
    "justification",
    "before_state_hash",
    "after_state_hash",
    "observed_at",
    "valid_from",
    "valid_to"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CHANGE-[0-9]{6}$"},
    "milestone_id": {"type": "string", "minLength": 1},
    "before_assessment_id": {"type": "string", "pattern": "^ASSESS-[0-9]{6}$"},
    "after_assessment_id": {"type": "string", "pattern": "^ASSESS-[0-9]{6}$"},
    "change_type": {"enum": ["none", "minor_progress", "evidence_upgrade", "milestone_reached", "setback", "invalidation"]},
    "trigger_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CLAIM-[0-9]{6}$"}},
    "trigger_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVID-[0-9]{6}$"}},
    "trigger_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{6}$"}},
    "review_id": {"type": "string", "pattern": "^REVIEW-[0-9]{6}$"},
    "justification": {"type": "string", "minLength": 10},
    "before_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "after_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"}
  }
}
