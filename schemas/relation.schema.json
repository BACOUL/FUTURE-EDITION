{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Edition Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "relation", "to"],
  "properties": {
    "from": {"type": "string", "minLength": 1},
    "relation": {"enum": ["HAS_MILESTONE", "USES_TECHNOLOGY", "RELATES_TO", "PRODUCES_CLAIM", "SUPPORTED_BY", "CONTRADICTED_BY", "LIMITED_BY", "CONTEXTUALIZED_BY", "DERIVED_FROM", "PROVENANCE_OF", "AFFILIATED_WITH", "AUTHORED_BY", "PUBLISHED_BY", "MAY_CHANGE", "SUPERSEDES", "REVIEWS", "ASSESSES", "JUSTIFIED_BY", "BASED_ON_EVENT", "CHANGES", "STATE_BEFORE", "STATE_AFTER", "REVIEWED_BY", "TRIGGERED_BY_CLAIM", "TRIGGERED_BY_EVIDENCE", "TRIGGERED_BY_EVENT"]},
    "to": {"type": "string", "minLength": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"}
  }
}
