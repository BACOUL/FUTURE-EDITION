{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-edition.example/schemas/question.schema.json",
  "title": "Future Edition Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "title", "summary", "evidence_profile", "milestones"],
  "properties": {
    "id": {"type": "string", "pattern": "^Q-[0-9]{3}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 10},
    "summary": {"type": "string", "minLength": 20},
    "evidence_profile": {"enum": ["medical", "technology", "fundamental_science", "mixed"]},
    "milestones": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "criterion"],
        "properties": {
          "id": {"type": "string"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
