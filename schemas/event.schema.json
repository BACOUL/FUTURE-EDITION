{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Edition Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "event_date", "question_ids", "status", "change_type", "human_review"],
  "properties": {
    "id": {"type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{6}$"},
    "title": {"type": "string"},
    "event_date": {"type": "string", "format": "date"},
    "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "technology_ids": {"type": "array", "items": {"type": "string"}},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["candidate", "verified", "published", "rejected", "invalidated"]},
    "change_type": {"enum": ["none", "minor_progress", "evidence_upgrade", "milestone_reached", "setback", "invalidation", "unassessed"]},
    "human_review": {"enum": ["required", "approved", "rejected", "not_required"]}
  }
}
