{
  "name": "future-edition",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:schemas": "node pipeline/validate-schemas.mjs",
    "validate:data": "node pipeline/validate-data.mjs && node pipeline/validate-schemas.mjs && node pipeline/validate-relations.mjs",
    "test:fe02": "node pipeline/test-fe02-model.mjs",
    "verify:determinism": "node pipeline/verify-determinism.mjs",
    "build:graph": "node pipeline/build-graph.mjs && node pipeline/validate-graph.mjs && node pipeline/verify-determinism.mjs",
    "build:web": "node pipeline/build-site.mjs && node pipeline/validate-output.mjs",
    "build": "node pipeline/run-local.mjs",
    "dev": "node pipeline/run-local.mjs && node pipeline/serve.mjs",
    "validate:state": "node pipeline/validate-current-state.mjs",
    "test:state": "node pipeline/test-state-resolution.mjs",
    "test:fe03:core": "node pipeline/test-fe03-core.mjs",
    "test:fe03:contracts": "node pipeline/test-fe03-contracts.mjs",
    "test:fe03:resolver": "node pipeline/test-fe03-resolver.mjs",
    "test:fe03:bridge": "node pipeline/test-fe03-bridge.mjs",
    "bench:fe03:synthetic": "node benchmarks/fe03/run-synthetic.mjs",
    "test:fe03:locators": "node pipeline/test-fe03-locators.mjs"
  }
}
